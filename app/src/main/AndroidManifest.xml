<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Exact-alarm permissions. These let AlarmManager fire at a precise moment
        even while the phone is dozing.

        USE_EXACT_ALARM (API 33+): auto-granted at INSTALL. No settings page, no
            runtime prompt. This is why we prefer it over SCHEDULE_EXACT_ALARM for
            a sideloaded app.
        SCHEDULE_EXACT_ALARM (capped at API 32): the older permission, used only
            on Android 12/12L where USE_EXACT_ALARM doesn't exist yet. Auto-granted
            on those versions.
        (On API 26-30, exact alarms need no permission at all.)

        Note: still NO INTERNET permission anywhere in this app.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
        Needed only to SHOW the ongoing countdown notification. On Android 13+
        this is a runtime permission the user must grant (we ask on the setup
        screen). It's about displaying a notification, not the internet — still
        no INTERNET permission in this app.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Lets us show the "ignore battery optimizations?" system dialog. Being on
        that exemption list is what stops One UI/Doze from delaying or dropping
        our overnight alarm. (Google Play restricts this permission; irrelevant
        here since we sideload.)
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepTimerTile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SleepTimerTile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Opened when the user LONG-PRESSES the tile. The system launches the
            activity registered for the QS_TILE_PREFERENCES action. A transparent
            theme makes it float as a dialog; excludeFromRecents keeps it out of
            the recent-apps list.
        -->
        <activity
            android:name=".DurationPickerActivity"
            android:theme="@style/Theme.SleepTimerTile.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
            The Quick Settings tile.

            android:permission="...BIND_QUICK_SETTINGS_TILE"
                This does NOT grant US anything. It says: only a caller that
                already holds this permission may bind to this service. The
                Android system holds it; nothing else does. So this line means
                "only the OS can talk to this service" — which is exactly what
                you want for something that lives in the system's shade.

            android:exported="true"
                Required, because the process binding to us (system_server) is a
                different process. Without this the tile won't appear.

            The <action android:name="...action.QS_TILE"/> intent-filter is how
            Android discovers that this service is a tile and lists it in the
            "edit tiles" tray.

            android:icon / android:label are what show on the tile itself.
        -->
        <service
            android:name=".SleepTimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sleep"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Receives the alarm when the timer expires, then locks the screen.
            exported="false": nothing outside this app should ever trigger it;
            it's fired only by our own PendingIntent via AlarmManager.
        -->
        <receiver
            android:name=".TimerExpiredReceiver"
            android:exported="false" />

        <!-- Backs the "Cancel" action on the countdown notification. -->
        <receiver
            android:name=".CancelTimerReceiver"
            android:exported="false" />

        <!--
            Notification Listener service. We never read notifications; being an
            enabled listener is simply Android's precondition for calling
            MediaSessionManager.getActiveSessions() to pause the playing app.

            android:permission="...BIND_NOTIFICATION_LISTENER_SERVICE": only the
                system may bind it.
            The NotificationListenerService action lets the system discover it and
                list it on the "Notification access" settings page.
            This access is OPTIONAL — without it, media pause falls back to the
                media key event, which needs no permission.
        -->
        <service
            android:name=".MediaNotificationListener"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            The Device Admin receiver. This is what grants us lockNow().

            android:permission="...BIND_DEVICE_ADMIN": only the system may bind it.
            exported="true": required, because the system (a different process)
                binds it.
            meta-data android.app.device_admin -> res/xml/device_admin.xml: points
                at the policy file that says we only want <force-lock>.
            The DEVICE_ADMIN_ENABLED action lets the system deliver the "you were
                just enabled" callback.
        -->
        <receiver
            android:name=".SleepAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>